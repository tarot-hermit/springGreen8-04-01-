<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.spring.springGreen8.dao.WatchedDAO">

    <resultMap id="watchedResultMap" type="com.spring.springGreen8.vo.WatchedVO">
        <id     property="watchedId" column="watched_id"/>
        <result property="mid"       column="mid"/>
        <result property="movieId"   column="movie_id"/>
        <result property="regDate"   column="reg_date"/>
        <result property="title"     column="title"/>
        <result property="posterPath" column="poster_path"/>
    </resultMap>

    <!-- 봤어요 추가 (중복 시 무시) -->
    <insert id="insertWatched">
        INSERT IGNORE INTO watched (mid, movie_id)
        VALUES (#{mid}, #{movieId})
    </insert>

    <!-- 봤어요 취소 -->
    <delete id="deleteWatched">
        DELETE FROM watched
        WHERE mid = #{mid}
          AND movie_id = #{movieId}
    </delete>

    <!-- 봤어요 여부 확인 -->
    <select id="checkWatched" resultType="int">
        SELECT COUNT(*)
        FROM watched
        WHERE mid = #{mid}
          AND movie_id = #{movieId}
    </select>

    <!-- 내 봤어요 목록 -->
    <select id="selectMyWatched" resultMap="watchedResultMap">
        SELECT
            w.watched_id,
            w.mid,
            w.movie_id,
            w.reg_date,
            m.title,
            m.poster_path
        FROM watched w
        LEFT JOIN movie m
               ON w.movie_id = m.tmdb_id
        WHERE w.mid = #{mid}
        ORDER BY w.reg_date DESC
    </select>

    <delete id="deleteWatchedByMid">
        DELETE FROM watched
        WHERE mid = #{mid}
    </delete>

</mapper>